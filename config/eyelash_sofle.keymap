#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

// Keep every built-in behavior in both halves' firmware, not just the ones this file uses.
// Otherwise a behavior assigned only in ZMK Studio (e.g. Backlight) is missing from the right
// half, so it ignores it when the left half forwards it.
#define ZMK_BEHAVIORS_KEEP_ALL

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Remove the board's spare USB serial port (only used for debug logging, which is off),
// so ZMK Studio lists a single USB port: its own, from the studio-rpc-usb-uart snippet.
/delete-node/ &cdc_acm_uart;

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // Knob: one action per encoder tick (the board default was one per 2 ticks). With 2 ticks
    // per detent the old setting could leave a 1-tick remainder, so the first click after
    // reversing only cancelled it and did nothing. Now nothing is left over; each click sends
    // 2 actions (e.g. 2 volume steps = 4% on Windows).
    sensors {
        triggers-per-rotation = <40>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        // Behaviors that run on both halves (screen, underglow) need node names of at most
        // 8 characters: that's all the split link carries when the left half triggers them.

        // Underglow brightness in finer steps at the low end (the layer LEDs follow it)
        ug_brighter: ug_bri_u {
            compatible = "zmk,behavior-underglow-dim-step";
            #binding-cells = <0>;
            display-name = "Custom: Underglow brighter";
            brighter;
        };

        // Flip both screens between black-on-white and white-on-black (remembered)
        screen_invert: scr_inv {
            compatible = "zmk,behavior-display-invert";
            #binding-cells = <0>;
            display-name = "Custom: Screen invert";
        };

        // Show/hide the battery percentage on both screens (remembered)
        battery_pct: bat_pct {
            compatible = "zmk,behavior-battery-pct";
            #binding-cells = <0>;
            display-name = "Custom: Battery %";
        };

        ug_dimmer: ug_bri_d {
            compatible = "zmk,behavior-underglow-dim-step";
            #binding-cells = <0>;
            display-name = "Custom: Underglow dimmer";
        };

        // Hold for layer 1; hold together with Shift for layer 2
        layer_1_shift_2: layer_1_shift_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Custom: Layer 1 / Shift: 2";
            bindings = <&mo 1>, <&mo 2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Hold for the layer while held; tap to switch it on until tapped again.
        // Usage: &hold_tog <layer> <layer>; ZMK Studio shows a layer picker for each.
        hold_tog: hold_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Custom: Layer hold / tap toggle";
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };

        // Same, for layer 1; with Shift held it does the same for layer 2
        hold_tog_1_shift_2: hold_tog_1_shift_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Custom: Layer 1 / Shift: 2 (tap toggles)";
            bindings = <&hold_tog 1 1>, <&hold_tog 2 2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
            display-name = "Custom: Shift + middle click";
        };

        // Types "00" (two zeros from the number row; works whatever Num Lock is set to)
        double_zero: double_zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Custom: 00";
            bindings = <&macro_tap &kp N0 &kp N0>;
        };

        // "_" normally, "." with Shift (Shift is released for it, so "." and not ">")
        under_dot: under_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Custom: _ / Shift: .";
            bindings = <&kp UNDER>, <&kp DOT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Left Alt that never activates Windows' menu bar on its own. Windows does that only
        // when Alt goes down and up with nothing in between, so an unused key (F24) is tapped
        // just before Alt is released. Alt + key and Alt + mouse work as normal.
        alt_masked: alt_masked {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Custom: Alt (no menu on its own)";
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_tap &kp F24>
                , <&macro_release &kp LALT>
                ;
        };

        // Revit formulas: jump to the start of the field and type "="
        home_eq_macro: home_eq_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Custom: Home = Enter (macro only)";
            bindings = <&macro_tap &kp HOME &kp EQUAL &kp ENTER>;
        };

        // The "Home =" key: Home, "=", Enter normally; with Shift held just "=" (Shift is
        // released for it, so it types "=", not "+"). Keeps the node name home_equal so
        // keys assigned to it in ZMK Studio pick this up.
        home_equal: home_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Custom: Home = Enter / Shift: =";
            bindings = <&home_eq_macro>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp CAPS    &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp ENTER
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &alt_masked  &mo 1   &kp SPACE    &kp ENTER        &kp SPACE  &kp ENTER  &mo 2      &kp RIGHT_SHIFT  &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &ug_brighter     &ug_dimmer  &kp INSERT  &kp F11    &kp F12           &screen_invert
&kp C_PP    &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "layer1";

            // Seek in players that use plain arrows (Jellyfin, YouTube, mpv, MPC-HC)
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&kp C_PP   &trans        &trans          &trans        &trans        &trans          &mkp LCLK        &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "layer2";

            // Seek in VLC (Shift+arrow = 5 seconds)
            sensor-bindings = <&inc_dec_kp LS(RIGHT) LS(LEFT)>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer3";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
