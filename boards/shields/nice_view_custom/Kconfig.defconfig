if SHIELD_NICE_VIEW_CUSTOM

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply NICE_VIEW_WIDGET_STATUS

config NICE_VIEW_WIDGET_STATUS
    bool "Custom nice!view status widget"
    select LV_FONT_MONTSERRAT_16
    select LV_USE_IMG
    select LV_USE_CANVAS

config NICE_VIEW_WIDGET_INVERTED
    bool "Invert custom status widget colors"

if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

# No WPM graph on this screen, so ZMK_WPM is not selected and WPM tracking stays off.
config NICE_VIEW_WIDGET_STATUS
    select LV_FONT_MONTSERRAT_18
    select LV_FONT_MONTSERRAT_14

endif # !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

# Layer indicator LEDs: layer 1 on the left half, layer 2 on the right half. Index = position
# in that half's LED chain, from 0; -1 = no LED for that layer on this half.
config LAYER_LEDS
    bool "Light an underglow LED for layers 1 and 2"
    default y
    depends on ZMK_RGB_UNDERGLOW

config LAYER_LEDS_LAYER1_INDEX
    int "Underglow LED for layer 1 on this half (-1 = none)"
    # Left: 1st LED in the chain (the chain runs right to left, so the inner column)
    default 0 if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    default -1
    depends on LAYER_LEDS

config LAYER_LEDS_LAYER2_INDEX
    int "Underglow LED for layer 2 on this half (-1 = none)"
    # Right: 1st LED in its chain, assuming it mirrors the left half
    default -1 if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    default 0
    depends on LAYER_LEDS

config LAYER_LEDS_FINDER
    bool "Flash each underglow LED in turn at power-on, to find their positions"
    depends on LAYER_LEDS

config ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    select LV_FONT_MONTSERRAT_26

endif # SHIELD_NICE_VIEW_CUSTOM
